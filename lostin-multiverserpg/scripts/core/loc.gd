extends Node
## Central localization (I18n) and persistent settings manager.
## Autoload: Loc
## Supports English ("en") and Bahasa Indonesia ("id").

signal language_changed(new_lang: String)
signal settings_changed

const SETTINGS_FILE := "user://settings.json"
const LANG_EN := "en"
const LANG_ID := "id"

var lang: String = "en":
	set(v):
		var old := lang
		lang = v if v in [LANG_EN, LANG_ID] else LANG_EN
		TranslationServer.set_locale(lang)
		if lang != old:
			save_settings()
			language_changed.emit(lang)

var music_volume: float = 0.8
var sfx_volume: float = 0.8
var muted: bool = false
var fullscreen: bool = false


func _init() -> void:
	_init_translations()


func _init_translations() -> void:
	var trans_id := Translation.new()
	trans_id.locale = LANG_ID
	for k in ID_STRINGS:
		trans_id.add_message(k, ID_STRINGS[k])
	TranslationServer.add_translation(trans_id)

	var trans_en := Translation.new()
	trans_en.locale = LANG_EN
	for k in EN_STRINGS:
		trans_en.add_message(k, EN_STRINGS[k])
	TranslationServer.add_translation(trans_en)

	TranslationServer.set_locale(lang)


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	load_settings()


func load_settings() -> void:
	if not FileAccess.file_exists(SETTINGS_FILE):
		return
	var f := FileAccess.open(SETTINGS_FILE, FileAccess.READ)
	if f == null:
		return
	var text := f.get_as_text()
	f.close()
	var json = JSON.parse_string(text)
	if typeof(json) != TYPE_DICTIONARY:
		return
	var d: Dictionary = json
	lang = d.get("lang", "en")
	music_volume = clampf(float(d.get("music_volume", 0.8)), 0.0, 1.0)
	sfx_volume = clampf(float(d.get("sfx_volume", 0.8)), 0.0, 1.0)
	muted = bool(d.get("muted", false))
	fullscreen = bool(d.get("fullscreen", false))
	_apply_audio()
	_apply_display()


func save_settings() -> void:
	var f := FileAccess.open(SETTINGS_FILE, FileAccess.WRITE)
	if f == null:
		return
	var d := {
		"lang": lang,
		"music_volume": music_volume,
		"sfx_volume": sfx_volume,
		"muted": muted,
		"fullscreen": fullscreen,
	}
	f.store_string(JSON.stringify(d, "  "))
	f.close()
	settings_changed.emit()


func set_language(l: String) -> void:
	lang = l


func toggle_language() -> void:
	lang = LANG_ID if lang == LANG_EN else LANG_EN


func set_music_vol(v: float) -> void:
	music_volume = clampf(v, 0.0, 1.0)
	_apply_audio()
	save_settings()


func set_sfx_vol(v: float) -> void:
	sfx_volume = clampf(v, 0.0, 1.0)
	_apply_audio()
	save_settings()


func set_muted_state(m: bool) -> void:
	muted = m
	_apply_audio()
	save_settings()


func set_fullscreen_state(fs: bool) -> void:
	fullscreen = fs
	_apply_display()
	save_settings()


func _apply_audio() -> void:
	if Engine.has_singleton("Sfx") or has_node("/root/Sfx"):
		var s = get_node_or_null("/root/Sfx")
		if s:
			s.muted = muted
			s.music_db = linear_to_db(music_volume) if music_volume > 0.001 else -80.0
			s.sfx_db = linear_to_db(sfx_volume) if sfx_volume > 0.001 else -80.0
			if s.music_a and s.music_a.playing:
				s.music_a.volume_db = s.music_db
			if s.music_b and s.music_b.playing:
				s.music_b.volume_db = s.music_db


func _apply_display() -> void:
	if fullscreen:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)


# =============================================================== TRANSLATION
## Keys asked for while Indonesian is active but that have no translation (debug aid).
var missing: Dictionary = {}


func t(message: Variant, context: Variant = null) -> String:
	var key := str(message)
	if lang == LANG_ID:
		if ID_STRINGS.has(key):
			return ID_STRINGS[key]
		if OS.is_debug_build() and key.length() > 1 and key.to_lower() != key.to_upper():
			missing[key] = true
	else:
		if EN_STRINGS.has(key):
			return EN_STRINGS[key]
	return tr(key, str(context) if context != null else &"")


